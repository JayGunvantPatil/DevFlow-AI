# DevFlow AI Environment Variables (Template)
# Copy this file to .env.local for local development. NEVER commit actual secrets.

# Backend & App Config (Frontend accessible via import.meta.env)
VITE_APP_ENV=development
VITE_API_BASE_URL=

# Neon Serverless PostgreSQL Database Connection String
# Server-side ONLY: Never prefix with VITE_ or expose to client bundles.
# Read exclusively by Vercel Serverless Functions and local Vite API middleware.
DATABASE_URL=

# Authentication Secret (Server-side ONLY)
# Used to sign and verify HMAC-SHA256 session tokens. Generate a 32+ character random string.
JWT_SECRET=

# Future Phase Integrations (Planned for Phases 3 & 4)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
